// Prisma multi-file schema (needs Prisma >= 6.7). Each intern adds models in THEIR OWN .prisma file
// in this folder (e.g. jobs.prisma, applications.prisma, ai.prisma) -> no merge conflicts.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
