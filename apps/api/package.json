{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"add eslint later\"",
    "test": "vitest run --passWithNoTests",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "admin:create": "nest build && node dist/cli/create-platform-admin.js",
    "company:assign-admin": "nest build && node dist/cli/assign-company-admin.js",
    "resumes:to-storage": "nest build && node dist/cli/move-resumes-to-storage.js",
    "sql:seed": "nest build && node dist/cli/seed-sql-questions.js",
    "test:db": "vitest run tests/multi-company.e2e.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@hireflow/contracts": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "livekit-server-sdk": "^2.19.2",
    "nodemailer": "6.9.16",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/multer": "1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "6.4.17",
    "prisma": "^6.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
