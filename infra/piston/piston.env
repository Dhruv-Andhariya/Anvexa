# Settings for the Piston code runner (docker --env-file). No secrets in this file.
# Each name is PISTON_<option>; the options come from /piston_api/src/config.js of the pinned image.
# These are CEILINGS: the HireFlow backend asks for tighter limits per run (see apps/api .../execution/piston.runner.ts).

PISTON_LOG_LEVEL=INFO

# Student code gets no network at all (this is also Piston's default; stated here on purpose).
PISTON_DISABLE_NETWORKING=true

# A run's stdout and stderr are each cut at this size. Piston's default (1024) is too small: a student's debug
# prints could push the result line out of it and fail a correct answer. A run that prints more is killed.
PISTON_OUTPUT_MAX_SIZE=65536

# Executions Piston runs at the same time. The backend limits itself to 3 (DSA_RUNNER_CONCURRENCY), leaving headroom.
PISTON_MAX_CONCURRENT_JOBS=4

PISTON_MAX_PROCESS_COUNT=64
PISTON_MAX_OPEN_FILES=512
PISTON_MAX_FILE_SIZE=10000000

# Ceilings in milliseconds. Java compiles inside its run (single-file source mode), so its run limits cover javac too.
PISTON_COMPILE_TIMEOUT=15000
PISTON_COMPILE_CPU_TIME=15000
PISTON_RUN_TIMEOUT=8000
PISTON_RUN_CPU_TIME=8000

# Ceilings in bytes: run 256 MiB, compile 512 MiB.
PISTON_RUN_MEMORY_LIMIT=268435456
PISTON_COMPILE_MEMORY_LIMIT=536870912

# Java needs more room: JVM overhead, and more threads.
PISTON_LIMIT_OVERRIDES={"java":{"max_process_count":128,"compile_memory_limit":805306368,"run_memory_limit":536870912}}
