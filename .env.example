# Copy to .env and fill in. NEVER commit .env
# ---- Database / infra (values match docker-compose) ----
# PostgreSQL already installed on 5432? Start docker with POSTGRES_PORT=5433 and use localhost:5433 below.
DATABASE_URL=postgresql://hire:hire@localhost:5433/hireflow
REDIS_URL=redis://localhost:6379
# ---- Resume files (M09) ----
# s3 = every resume goes to the S3 bucket; the database keeps only its record (name, size, sha256, key).
# Empty / database = bytes in the resume_files table (local dev only; refused when NODE_ENV=production).
# Files from before: RESUME_STORAGE=s3 pnpm --filter api resumes:to-storage
RESUME_STORAGE=
# AWS: S3_ENDPOINT EMPTY, S3_REGION = the bucket's region (e.g. ap-south-1 Mumbai), keys of an IAM user that may only
# s3:PutObject + s3:GetObject + s3:DeleteObject on arn:aws:s3:::<bucket>/*. Keys empty = the standard AWS chain.
# S3-compatible service or a local mock: set S3_ENDPOINT (e.g. http://127.0.0.1:9090 for adobe/s3mock).
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=hireflow
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_URL=smtp://localhost:1025
# Gmail for the "thanks for applying" email (M09). Fill BOTH to send real emails through Gmail;
# leave empty to use SMTP_URL above (Mailpit, local test inbox). GMAIL_APP_PASSWORD = 16-letter Google App Password
# (Google Account > Security > 2-Step Verification > App passwords), NOT your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional sender, e.g. MAIL_FROM=Acme Careers <you@gmail.com> (with Gmail it must be the Gmail address)
# MAIL_FROM=
TEMPORAL_ADDRESS=localhost:7233

# ---- Service URLs ----
API_PORT=4000
AI_WORKER_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# invitation links point here (/invite/<token>)
HR_DASHBOARD_URL=http://localhost:3000

# ---- Auth (M28). Server-side sessions in an httpOnly cookie; no secrets reach the browser ----
# Production: list the dashboard origin(s); empty = only http://localhost:<port> may call the API with cookies
CORS_ORIGINS=
# Session cookie gets Secure automatically for HTTPS requests and in production; true forces it everywhere.
COOKIE_SECURE=false
# Login 2FA: email = after the right password a 6-digit code is emailed (needs GMAIL_* or SMTP_URL above);
# off = password only. Empty: on in production, off elsewhere.
LOGIN_2FA=email
# Sign-up email verification: email = the account is created only after the code emailed to it is entered; off = at once.
# Empty: on in production, off elsewhere. Code expiry / tries: LOGIN_CODE_TTL_MINUTES / LOGIN_CODE_MAX_ATTEMPTS.
SIGNUP_VERIFY_EMAIL=email
# "Continue with Google" on the HR login + sign-up pages (empty = buttons hidden). Google Cloud Console ->
# APIs & Services -> Credentials -> OAuth client ID (Web application). Authorized redirect URI = GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5
SESSION_TTL_HOURS=12
INVITATION_TTL_HOURS=168
LOGIN_MAX_ATTEMPTS=10
SIGNUP_MAX_PER_IP=10
# First Platform Admin (only for `pnpm --filter api admin:create`; do not leave the password in this file)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_PASSWORD=

# ---- AI (Intern 2). Never hard-code model names in code - keep them here ----
LLM_PROVIDER=gemini
LLM_MODEL=
# Comma-separated backups, tried in order when LLM_MODEL is overloaded (5xx) or out of quota (429). Optional.
LLM_FALLBACK_MODELS=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# optional tuning (defaults shown)
LLM_TIMEOUT_SECONDS=60
LLM_TRANSIENT_RETRIES=1
AI_WORKER_TIMEOUT_MS=90000
# Total time the worker may spend on one JD (all retries + fallback models). Keep below AI_WORKER_TIMEOUT_MS.
JD_GENERATION_BUDGET_SECONDS=80
# M10/M11 resume screening (API background loop -> AI worker POST /v1/resume/screen).
# Total time the worker may spend on one resume; keep below ATS_WORKER_TIMEOUT_MS.
RESUME_SCREEN_BUDGET_SECONDS=80
# Scanned PDF resumes (no text layer): Gemini reads the page images, then the normal screening runs.
# false = such resumes go straight to HR review (saves one Gemini call per scan).
RESUME_OCR_FALLBACK=true
ATS_WORKER_TIMEOUT_MS=100000
# Background loop: off with ATS_PROCESSING=off (or FEATURE_ATS=off for the whole ATS feature). Always off in tests.
ATS_PROCESSING=on
ATS_POLL_MS=5000
# Resumes screened at the same time by one API process (each is one LLM call).
ATS_CONCURRENCY=2
# AI screening round page (M12). The shortlist email links here with the candidate's own token (?token=..., or put
# {token} in the URL). Empty = ${CAREERS_SITE_URL}/screening/{token} (the careers site's screening page). Neither set =
# shortlist emails cannot be sent yet; rejection emails still can. In production a localhost link is refused.
AI_SCREENING_URL=
# Screened students below the job's minimum ATS score (or set to "not shortlisted" by HR) get the rejection email
# automatically, right away. A resume that could not be screened never does (it waits for HR review).
# off = HR sends rejections by hand too.
AUTO_REJECTION_EMAILS=on
# Screened students at or above the job's minimum ATS score (or shortlisted by HR) get the shortlist email with their
# AI screening link automatically, right away - no HR click. Only when that link is PUBLIC (AI_SCREENING_URL, or
# CAREERS_SITE_URL from the tunnel / a deployment): with a localhost link HR sends it by hand. off = HR sends them.
AUTO_SHORTLIST_EMAILS=on

# ---- M12 AI screening round (voice; apps/api/src/modules/screening + AI worker /v1/screening/*) ----
# The candidate's answer is heard by LLM_MODEL (Gemini reads audio); questions are spoken by a text-to-speech model.
# Each TTS model has its own (small on the free tier) quota: the fallbacks are tried on 429 / 5xx.
SCREENING_TTS_MODEL=gemini-3.8-flash-tts
SCREENING_TTS_FALLBACK_MODELS=gemini-3.8-flash-lite-tts,gemini-2.5-flash-preview-tts
SCREENING_TTS_VOICE=Kore
# AI worker time budgets (seconds) and "thinking" tokens per turn (0 = off, about 2x faster).
SCREENING_TURN_BUDGET_SECONDS=25
SCREENING_SPEECH_BUDGET_SECONDS=20
SCREENING_EXTRACT_BUDGET_SECONDS=60
# M05 assessment rounds: AI question suggestions for HR (AI worker side; below the API timeout)
ROUND_QUESTIONS_BUDGET_SECONDS=75
SCREENING_THINKING_BUDGET=0
# API -> AI worker timeouts (ms); keep above the worker budgets.
SCREENING_WORKER_TIMEOUT_MS=35000
SCREENING_SPEECH_TIMEOUT_MS=30000
SCREENING_EXTRACT_TIMEOUT_MS=75000
# M05: how long the API waits for AI question suggestions
ROUND_QUESTIONS_WORKER_TIMEOUT_MS=90000
# Conversation limits (server-enforced): follow-ups per question, candidate questions, answered turns, minutes.
SCREENING_FOLLOW_UPS_PER_QUESTION=1
SCREENING_MAX_CANDIDATE_QUESTIONS=3
SCREENING_MAX_TURNS=18
SCREENING_MAX_MINUTES=15

# ---- M13 online test rounds (Aptitude & English, Technical MCQ...; apps/api/src/modules/round-engine) ----
# Candidate page: careers site /assessment/{token}. Empty = ${CAREERS_SITE_URL}/assessment/{token} (follows the tunnel /
# deployment). Invitations are only emailed when this link is PUBLIC (not localhost); until then they wait in the queue.
ASSESSMENT_URL=
# Days an assessment link works, counted from the moment its email was sent.
ASSESSMENT_LINK_DAYS=7
# on = the webcam must be on during a test (preview only, never recorded; camera / tab / full-screen EVENTS are logged
# for HR). off = camera optional. Proctoring events never fail a candidate by themselves.
ASSESSMENT_REQUIRE_CAMERA=on
# on = a candidate whose AI voice screening is COMPLETED is invited to the job's first round automatically (when that
# round is an online test: MCQ / true-false questions only). off = no automatic invitations.
AUTO_ROUND_INVITES=on
# Background loop (invitations, outcome emails, time-outs). Always off in tests.
ROUND_ENGINE_PROCESSING=on
ROUND_ENGINE_POLL_MS=5000
# Local testing with Mailpit only: also email links whose host is localhost.
ROUND_ALLOW_LOCAL_LINKS=off

# ---- DSA coding round (dsa module + candidate app /dsa/{token}) ----
# A round with only Coding questions and a score pass rule runs on the DSA page: students who pass the round before
# it get an emailed link, solve the coding problems, and are graded against HR's pass rule (next round / rejection).
# Public address of the candidate app (:3001). scripts/start-public.ps1 writes it, and only while JUDGE0_URL is set:
# without a code runner every submission fails and students would be graded 0. Empty = coding invitations wait.
DSA_SITE_URL=
# Optional full link with {token}; empty = ${DSA_SITE_URL}/dsa/{token}.
DSA_URL=
# Code runner. Hosted Judge0 CE on RapidAPI: JUDGE0_URL=https://judge0-ce.p.rapidapi.com,
# JUDGE0_AUTH_HEADER=X-RapidAPI-Key, JUDGE0_AUTH_TOKEN=<your key>, JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com.
# Every submission and every result poll is one request against the plan's quota (the free plan is tiny).
JUDGE0_AUTH_HEADER=
JUDGE0_AUTH_TOKEN=
JUDGE0_RAPIDAPI_HOST=
# Time between result polls (each poll is a request; 1000 or more for a hosted Judge0).
DSA_JUDGE0_POLL_INTERVAL_MS=300

# ---- Later versions (leave empty for now) ----
KEYCLOAK_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# DSA coding round code runner (see the DSA section above). Empty = DSA coding invitations are not sent.
JUDGE0_URL=
WHATSAPP_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 32 random bytes, base64. Encrypts channel OAuth tokens. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ---- M06-M09 publisher + apply (Intern 3 area). Safe local defaults shown ----
# Public URL of apps/careers-site (the "Apply here" link in every post points here).
CAREERS_SITE_URL=http://localhost:3300
# When CAREERS_SITE_URL changed (temporary tunnel restarted), the API edits the posts already made at start so they
# carry the new apply link (same post, likes kept). Set to false to only do it by hand ("Update apply link in posts").
PUBLISHER_AUTO_REFRESH_LINKS=true
# LinkedIn company-page posts (Posts API). Needs a LinkedIn app with the Community Management API
# product. The Company Admin clicks "Connect LinkedIn" on the HR dashboard Publish page (OAuth); the token is stored
# per company, encrypted with ENCRYPTION_KEY. The page id is also set there.
# LinkedIn app -> Auth tab: Client ID / Primary Client Secret.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must be added EXACTLY to the app's "Authorized redirect URLs for your app" (Auth tab).
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/v1/publisher/linkedin/callback
# organization = company page (needs Community Management API); member = personal profile of whoever connects (demo).
LINKEDIN_POST_AS=organization
# Empty = picked from LINKEDIN_POST_AS (organization: w_organization_social, member: openid profile w_member_social).
LINKEDIN_SCOPES=
# Optional fallback for one company without the Connect button (scope w_organization_social of a page admin).
LINKEDIN_ACCESS_TOKEN=
# The ONLY company (tenant id) allowed to use LINKEDIN_ACCESS_TOKEN. Empty = the fallback token is never used.
LINKEDIN_FALLBACK_TENANT_ID=
# The ONLY LinkedIn account (OpenID sub) allowed to connect and post. Empty = any. After a connect the API log
# prints `linkedin connected ... account=<id>` (also channel_credentials.account_id): put that id here.
LINKEDIN_ALLOWED_MEMBER_ID=
# LinkedIn-Version header (YYYYMM). Take the current one from LinkedIn's docs - not guessed in code.
LINKEDIN_API_VERSION=
# Phone OTP: "dev" shows the code on screen (local only, refused in production). No SMS provider yet.
OTP_PROVIDER=dev
# 32+ random chars. Required in production (signs OTP proofs).
OTP_SIGNING_SECRET=
# Resume virus scan: "clamav" (needs: docker compose --profile security up -d clamav) or
# "dev-eicar-only" (local demo only, refused in production)
VIRUS_SCANNER=dev-eicar-only
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Per-IP limits per hour on the public apply endpoints. Defaults: otp-send=300,otp-verify=900,application=300,my-data=60.
# Raise for a big campus drive (a whole college on one Wi-Fi shares one IP), e.g. otp-send=2000,otp-verify=6000,application=2000
PUBLIC_RATE_LIMITS=
# Proxies allowed to tell the API the visitor's real IP (X-Forwarded-For). Default "loopback" = careers site / tunnel
# on this machine. Behind a load balancer: its hop count, e.g. 1. "false" = off, "true" = trust every hop.
TRUST_PROXY=
# Careers site: header with the student's real IP set by the edge in front of it, copied into X-Forwarded-For for the
# API (a visitor-sent X-Forwarded-For is always dropped). cf-connecting-ip = Cloudflare / Cloudflare tunnel, x-real-ip =
# nginx. Empty = local dev (all visitors count as one IP). The careers site must be reachable ONLY through that edge.
TRUSTED_CLIENT_IP_HEADER=
# Spam protection: Cloudflare Turnstile on "send OTP". Leave BOTH empty to switch CAPTCHA off (local dev).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Feature flags (doc 18.1): set to off to switch a module's routes off without a code change.
FEATURE_PUBLISHER=on
FEATURE_APPLICATIONS=on
FEATURE_SCREENING=on
# M05 assessment rounds + the HR Assessments page. off = publishing works as before (typed selection process)
FEATURE_ROUNDS=on
FEATURE_ROUND_ENGINE=on
